function selectSpecies(id){
  state.species = id;
  document.querySelectorAll('.species-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('sp-'+id).classList.add('selected');
  const sp = SPECIES_LIST.find(s => s.id === id);
  if(id === 'human'){
    showPage('page-subtype'); updateBreadcrumb(2);
  } else {
    const kits = ALL_KITS.filter(k => k.species === id);
    if(!kits.length){
      document.getElementById('coming-species-name').textContent = sp.name + ' \u7269\u79CD\u6570\u636E\u5E93';
      showPage('page-coming'); updateBreadcrumb(3);
    } else {
      state.currentMode = 'other';
      state.currentKits = kits;
      loadFactorsForKits(kits, sp.emoji+' '+sp.name, kits.length);
      updateBreadcrumb(3);
    }
  }
}

