function selectSubtype(type, event){
  state.subtype = type;
  document.querySelectorAll('.subtype-btn').forEach(b => b.classList.remove('selected'));
  if(event && event.currentTarget) event.currentTarget.classList.add('selected');
  if(type === 'screening'){
    state.currentMode = 'screening';
    state.currentKits = [SCREENING_KIT];
    loadScreeningFactors();
  } else if(type === 'autoantibody'){
    state.currentMode = 'autoantibody';
    state.currentKits = AUTOAB_KITS;
    loadFactorsForKits(AUTOAB_KITS, '\u1F9EC \u81EA\u8EAB\u6297\u4F53\u514D\u75AB\u8BD5\u5242\u76D2', AUTOAB_KITS.length);
  } else {
    state.currentMode = 'validation';
    state.currentKits = VALIDATION_KITS;
    loadFactorsForKits(VALIDATION_KITS, '\u4EBA\u7C7B - \u9A8C\u8BC1\u578B', VALIDATION_KITS.length);
  }
  updateBreadcrumb(3);
}

function loadScreeningFactors(){
  const kit = SCREENING_KIT;
  const factors = kit.factors.map(f => ({name:f, group:guessGroup(f), kits:[kit.catNo]}));
  state.currentFactors = factors;
  document.getElementById('factor-context-info').innerHTML =
    `<strong>\u7B5B\u67E5\u578B \u00B7 ${kit.catNo}</strong>\uFF1A${kit.name}\u3002\u5305\u542B <strong>${kit.factors.length}</strong> \u4E2A\u56E0\u5B50\uFF0C\u52FE\u9009\u6216\u7C98\u8D34\u60A8\u611F\u5174\u8DA3\u7684\u56E0\u5B50\u67E5\u770B\u8986\u76D6\u60C5\u51B5\u3002`;
  renderFactorList(factors);
  showPage('page-factors');
}

function loadFactorsForKits(kits, label, kitCount){
  const factorMap = new Map();
  kits.forEach(kit => {
    (kit.factors || []).forEach(f => {
      const key = f.trim();
      if(!factorMap.has(key)) factorMap.set(key, {name:key, group:guessGroup(key), kits:[kit.catNo]});
      else factorMap.get(key).kits.push(kit.catNo);
    });
  });
  const allFactors = Array.from(factorMap.values());
  state.currentFactors = allFactors;
  document.getElementById('factor-context-info').innerHTML =
    `<strong>${label}</strong>\uFF1A\u5171 <strong>${allFactors.length}</strong> \u4E2A\u53EF\u68C0\u6D4B\u56E0\u5B50\uFF08\u6765\u81EA ${kitCount} \u6B3E\u8BD5\u5242\u76D2\uFF09\u3002\u52FE\u9009\u6216\u7C98\u8D34\u8F93\u5165\u60A8\u9700\u8981\u7684\u56E0\u5B50\u3002`;
  renderFactorList(allFactors);
  showPage('page-factors');
}

// ================================================================
// FACTOR GROUP CLASSIFIER
// ================================================================
function guessGroup(name){
  const n = name.toUpperCase();
  if(/^IL-?\d/.test(n)) return '\u767D\u4ECB\u7D20 IL';
  if(/^IFN/.test(n)) return '\u5E72\u6270\u7D20 IFN';
  if(/^TNF/.test(n)) return '\u80BF\u7624\u574F\u6B7B\u56E0\u5B50 TNF';
  if(/MMP/.test(n)) return '\u57FA\u8D28\u91D1\u5C5E\u86CB\u767D\u9176 MMP';
  if(/TIMP/.test(n)) return '\u6291\u5236\u56E0\u5B50 TIMP';
  if(/MCP|MIP|RANTES|CCL|CXCL|TARC|MDC|EOTAXIN|ENA|GCP|IP-10|I-TAC|MIG|BCA|SDF|FRACTALKINE|GRO|6CKINE|CTACK/.test(n)) return '\u8D8B\u5316\u56E0\u5B50';
  if(/CSF/.test(n)) return '\u96C6\u843D\u523A\u6FC0\u56E0\u5B50 CSF';
  if(/VEGF|FGF|EGF|PDGF|HGF|TGF|BMP|NGF|SCF|BDNF|GDNF|IGF/.test(n)) return '\u751F\u957F\u56E0\u5B50';
  if(/GRANZYME|PERFORIN|SFAS|sFAS|SFASL|sFASL|TRAIL|TSLP|LIF|TPO|APRIL|BAFF|OPG|RANKL|DKK|OSTEO|HMGB/.test(n)) return '\u7EC6\u80DE\u56E0\u5B50/\u5176\u4ED6';
  if(/AMYLIN|INSULIN|LEPTIN|GLUCAGON|GLP|GIP|C-PEP|GHRELIN|PYY|PP$|SECRETIN/.test(n)) return '\u4EE3\u8C22\u6FC0\u7D20';
  if(/ACTH|FSH|LH|TSH|GH$|PROLACTIN|CNTF/.test(n)) return '\u5782\u4F53/\u5185\u5206\u6CCC';
  if(/AMYLOID|TAU|SYNUCLEIN|GFAP|NSE|NEURO|BDNF/.test(n)) return '\u795E\u7ECF\u79D1\u5B66';
  if(/COMP|FIBROSIS|COLLAGEN/.test(n)) return '\u7EA4\u7EF4\u5316/\u9AA8';
  if(/^IGA$|^IGG|^IGM$|^IGE$/.test(n)) return '\u514D\u75AB\u7403\u86CB\u767D';
  if(/COMPLEMENT|^C1Q|^C3|^C4|^C5|FACTOR [BDHI]/.test(n)) return '\u8865\u4F53\u7CFB\u7EDF';
  if(/KIM-1|NGAL|CYSTATIN|CLUSTERIN|ALBUMIN/.test(n) && !/CCL/.test(n)) return '\u80BE\u810F\u635F\u4F24';
  if(/BNP|TROPONIN|FABP|CK-MB|MYOGLOBIN|VCAM|ICAM|SELECTIN/.test(n)) return '\u5FC3\u8840\u7BA1';
  if(/CEA|AFP|CA1|CA-|PSA|HE4|HCG/.test(n)) return '\u80BF\u7624\u6807\u5FD7\u7269';
  if(/AUTOANTIBODY|QUALITATIVE/.test(n)) return '\u81EA\u8EAB\u6297\u4F53\u68C0\u6D4B';
  if(/AAV|SARS|COV/.test(n)) return '\u75C5\u6BD2\u6297\u539F\u68C0\u6D4B';
  return '\u5176\u4ED6\u56E0\u5B50';
}

