<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Milliplex 试剂盒智能匹配工具</title>
<style>
:root{
  --primary:#003865;--accent:#0072CE;--accent2:#00A3E0;
  --teal:#00847F;--purple:#6A0DAD;
  --highlight:#E8F4FD;--success:#2E7D32;--success-bg:#E8F5E9;
  --warning:#E65100;--card-bg:#FFFFFF;--bg:#F4F7FB;
  --border:#D0DCE8;--text:#1A2D42;--text-light:#5A6E84;
  --radius:12px;--shadow:0 2px 12px rgba(0,56,101,0.10);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'PingFang SC','Microsoft YaHei','Helvetica Neue',Arial,sans-serif;
  background:var(--bg);color:var(--text);min-height:100vh;padding-bottom:60px;}
/* ── Header ── */
.header{background:linear-gradient(135deg,var(--primary) 0%,#005A9E 55%,var(--accent2) 100%);
  color:#fff;padding:16px 20px;text-align:center;position:sticky;top:0;z-index:200;
  box-shadow:0 3px 14px rgba(0,0,0,0.22);}
.header .logo-row{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:4px;}
.merck-m{width:32px;height:32px;background:#fff;border-radius:7px;display:flex;
  align-items:center;justify-content:center;font-weight:900;color:var(--primary);font-size:17px;flex-shrink:0;}
.header .brand{font-size:12px;letter-spacing:2px;opacity:.8;text-transform:uppercase;}
.header h1{font-size:clamp(14px,3.8vw,21px);font-weight:700;letter-spacing:.4px;}
.header p{font-size:11.5px;opacity:.75;margin-top:3px;}
/* ── Breadcrumb ── */
.breadcrumb{display:flex;align-items:center;gap:6px;padding:9px 16px;
  background:#fff;border-bottom:1px solid var(--border);
  font-size:12px;color:var(--text-light);overflow-x:auto;white-space:nowrap;}
.step{display:flex;align-items:center;gap:4px;}
.step.active{color:var(--accent);font-weight:700;}
.step.done{color:var(--success);}
.sep{color:var(--border);}
.num{width:19px;height:19px;border-radius:50%;background:var(--border);
  color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;}
.step.active .num{background:var(--accent);}
.step.done .num{background:var(--success);}
/* ── Container/Pages ── */
.container{max-width:900px;margin:0 auto;padding:14px;}
.page{display:none;}
.page.active{display:block;animation:fadeIn .22s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
/* ── Card ── */
.card{background:var(--card-bg);border-radius:var(--radius);
  box-shadow:var(--shadow);padding:20px;margin-bottom:14px;border:1px solid var(--border);}
.card-title{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:14px;
  display:flex;align-items:center;gap:8px;}
/* ── Species grid ── */
.species-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;}
.species-btn{background:#fff;border:2px solid var(--border);border-radius:10px;
  padding:13px 8px;text-align:center;cursor:pointer;transition:all .2s;
  font-size:13px;font-weight:600;color:var(--text);display:flex;flex-direction:column;align-items:center;gap:5px;}
.species-btn:hover,.species-btn.selected{border-color:var(--accent);background:var(--highlight);color:var(--accent);}
.species-btn .emoji{font-size:26px;}
.species-badge{font-size:10px;background:#EEF4FA;color:var(--text-light);border-radius:4px;padding:1px 5px;margin-top:2px;}
/* ── Subtype grid — NOW 3 COLUMNS for human ── */
.subtype-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
@media(max-width:600px){.subtype-grid{grid-template-columns:1fr;}}
.subtype-btn{background:#fff;border:2px solid var(--border);border-radius:var(--radius);
  padding:18px 14px;cursor:pointer;transition:all .2s;text-align:center;position:relative;}
.subtype-btn:hover,.subtype-btn.selected{border-color:var(--accent);background:var(--highlight);}
.subtype-btn.autoab-btn:hover,.subtype-btn.autoab-btn.selected{border-color:var(--teal);background:#E0F5F4;}
.subtype-btn .type-name{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:6px;}
.subtype-btn .type-desc{font-size:11.5px;color:var(--text-light);line-height:1.55;}
.subtype-btn.selected .type-name{color:var(--accent);}
.subtype-btn.autoab-btn.selected .type-name{color:var(--teal);}
.type-badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;
  margin-bottom:7px;}
.badge-screening{background:#FFF3E0;color:#E65100;}
.badge-validation{background:#E8F5E9;color:#2E7D32;}
.badge-autoab{background:#E0F5F4;color:#00696C;}
/* ── Input mode tabs ── */
.input-mode-tabs{display:flex;margin-bottom:12px;border:2px solid var(--border);border-radius:8px;overflow:hidden;}
.tab-btn{flex:1;padding:9px 10px;background:#fff;border:none;font-size:13px;font-weight:600;
  cursor:pointer;color:var(--text-light);transition:all .2s;}
.tab-btn.active{background:var(--accent);color:#fff;}
.text-input-area{display:none;margin-bottom:12px;}
.text-input-area.active{display:block;}
.text-input-area textarea{width:100%;height:110px;padding:10px 13px;border:2px solid var(--border);
  border-radius:8px;font-size:13px;outline:none;resize:vertical;font-family:inherit;transition:border-color .2s;}
.text-input-area textarea:focus{border-color:var(--accent);}
.hint{font-size:11px;color:var(--text-light);margin-top:4px;}
/* ── Search ── */
.search-wrap{position:relative;margin-bottom:12px;}
.search-wrap input{width:100%;padding:10px 13px 10px 37px;border:2px solid var(--border);
  border-radius:8px;font-size:14px;outline:none;transition:border-color .2s;font-family:inherit;}
.search-wrap input:focus{border-color:var(--accent);}
.si{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-light);font-size:15px;}
/* ── Category filter ── */
.factor-categories{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;}
.cat-btn{padding:4px 11px;border-radius:20px;border:1px solid var(--border);
  background:#fff;font-size:12px;cursor:pointer;transition:all .2s;color:var(--text-light);}
.cat-btn:hover,.cat-btn.active{background:var(--accent);color:#fff;border-color:var(--accent);}
/* ── Factors container ── */
.factors-container{max-height:360px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;}
.factors-container::-webkit-scrollbar{width:5px;}
.factors-container::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px;}
.factor-group-header{padding:7px 13px;background:#EEF4FA;font-size:12px;font-weight:700;
  color:var(--primary);position:sticky;top:0;z-index:1;border-bottom:1px solid var(--border);}
.factor-item{display:flex;align-items:center;gap:9px;padding:8px 13px;
  border-bottom:1px solid #F0F4F8;cursor:pointer;transition:background .15s;}
.factor-item:last-child{border-bottom:none;}
.factor-item:hover{background:var(--highlight);}
.factor-item input[type=checkbox]{width:16px;height:16px;accent-color:var(--accent);flex-shrink:0;cursor:pointer;}
.factor-item label{font-size:13px;cursor:pointer;flex:1;line-height:1.4;}
.kb{font-size:10px;background:#E3F0FF;color:var(--accent);border-radius:4px;padding:1px 5px;flex-shrink:0;}
/* ── Selected bar ── */
.selected-bar{background:var(--highlight);border:1px solid #B3D4F0;border-radius:8px;
  padding:9px 13px;margin-bottom:12px;display:flex;align-items:flex-start;
  justify-content:space-between;flex-wrap:wrap;gap:7px;}
.sel-info{font-size:13px;color:var(--accent);font-weight:700;}
.selected-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px;}
.sel-tag{background:var(--accent);color:#fff;border-radius:6px;
  padding:3px 8px;font-size:11px;display:flex;align-items:center;gap:3px;}
.sel-tag .rm{cursor:pointer;font-size:13px;opacity:.8;}
/* ── Buttons ── */
.btn{padding:10px 20px;border-radius:8px;border:none;font-size:14px;font-weight:700;
  cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:6px;font-family:inherit;}
.btn-primary{background:var(--accent);color:#fff;}
.btn-primary:hover{background:var(--primary);}
.btn-primary:disabled{background:#9BB8D3;cursor:not-allowed;}
.btn-secondary{background:#fff;color:var(--text);border:2px solid var(--border);}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
.btn-danger{background:#fff;color:var(--warning);border:2px solid #FFCCD0;}
.btn-danger:hover{background:#FFF0F0;}
.btn-sm{padding:6px 13px;font-size:12px;}
.btn-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px;}
/* ── Results ── */
.result-kit{background:#fff;border:2px solid var(--border);border-radius:var(--radius);margin-bottom:13px;overflow:hidden;}
.result-kit.best-match{border-color:var(--accent);}
.kit-header{background:linear-gradient(90deg,var(--primary) 0%,var(--accent) 100%);
  color:#fff;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:7px;}
.result-kit.best-match .kit-header{background:linear-gradient(90deg,#005A9E 0%,var(--accent2) 100%);}
.kit-cat-no{font-size:15px;font-weight:700;}
.kit-badges{display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
.badge{padding:3px 9px;border-radius:12px;font-size:11px;font-weight:700;}
.badge-best{background:#FFD700;color:#7A5800;}
.badge-count{background:rgba(255,255,255,0.25);color:#fff;}
.kit-body{padding:15px;}
.match-stat{display:flex;align-items:center;gap:9px;margin-bottom:11px;}
.match-bar-wrap{flex:1;background:#EEF4FA;border-radius:4px;height:8px;overflow:hidden;}
.match-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .5s;}
.match-pct{font-size:13px;font-weight:700;color:var(--accent);min-width:40px;text-align:right;}
.match-label{font-size:12px;color:var(--text-light);white-space:nowrap;}
.factors-grid{display:flex;flex-wrap:wrap;gap:4px;}
.factor-tag{padding:3px 8px;border-radius:5px;font-size:11px;background:#F0F4F8;color:var(--text-light);}
.factor-tag.matched{background:#D6EAF8;color:var(--accent);font-weight:700;}
.factor-tag.matched::before{content:"✓ ";}
.toggle-btn{background:none;border:none;color:var(--accent);font-size:12px;cursor:pointer;padding:5px 0;text-decoration:underline;}
.no-result{text-align:center;padding:38px 18px;color:var(--text-light);}
.combo-box{background:linear-gradient(135deg,var(--success-bg),#fff);border:2px solid #A5D6A7;border-radius:var(--radius);padding:15px 18px;margin-bottom:14px;}
.combo-box.warn{background:#FFFDE7;border-color:#FFC107;}
.info-box{background:#FFF8E1;border-left:4px solid #FFC107;border-radius:6px;padding:9px 13px;font-size:12px;color:#6D4C00;margin-bottom:13px;line-height:1.6;}
.coming-soon{text-align:center;padding:28px;background:#F8FBFF;border:2px dashed var(--border);border-radius:var(--radius);color:var(--text-light);}
.ctx-box{background:var(--highlight);border:1px solid #B3D4F0;border-radius:8px;padding:10px 13px;font-size:12.5px;margin-bottom:12px;color:var(--text);line-height:1.6;}
/* ── Autoantibody result kit style ── */
.result-kit.autoab-kit .kit-header{background:linear-gradient(90deg,#00504D 0%,var(--teal) 100%);}
/* ── Fixed disclaimer bar ── */
.disclaimer-bar{position:fixed;left:0;right:0;bottom:0;z-index:9999;
  background:#fff;border-top:2px solid var(--border);padding:8px 16px;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 -2px 10px rgba(0,0,0,.06);font-size:11.5px;color:var(--text-light);
  line-height:1.4;text-align:center;}
.disclaimer-bar span{max-width:980px;display:block;}
/* ── Responsive ── */
@media(max-width:500px){
  .species-grid{grid-template-columns:repeat(3,1fr);}
  .btn-row{flex-direction:column;}
  .btn-row .btn{width:100%;justify-content:center;}
}
@media(min-width:600px){.species-grid{grid-template-columns:repeat(4,1fr);}}
@media(min-width:860px){.species-grid{grid-template-columns:repeat(6,1fr);}}
</style>
</head>
<body>

<!-- ─── HEADER ─── -->
<div class="header">
  <div class="logo-row">
    <div class="merck-m">M</div>
    <span class="brand">Merck | MilliporeSigma</span>
  </div>
  <h1>Milliplex&#174; 试剂盒智能匹配工具</h1>
  <p>多重免疫分析 &middot; 智能选型 &middot; 精准推荐 &nbsp;|&nbsp; 完整数据库 V5 &middot; 因子别名智能归并</p>
</div>

<!-- ─── BREADCRUMB ─── -->
<div class="breadcrumb">
  <div class="step" id="bc1"><div class="num">1</div><span>种属</span></div>
  <div class="sep">›</div>
  <div class="step" id="bc2"><div class="num">2</div><span>类型</span></div>
  <div class="sep" id="bc-sep2">›</div>
  <div class="step" id="bc3"><div class="num">3</div><span>因子</span></div>
  <div class="sep">›</div>
  <div class="step" id="bc4"><div class="num">4</div><span>结果</span></div>
</div>

<!-- ─── PAGES ─── -->
<div class="container">

<!-- PAGE 1: 种属选择 -->
<div class="page active" id="page-species">
  <div class="card">
    <div class="card-title">&#x1F43E; 第一步：选择种属</div>
    <p style="font-size:13px;color:var(--text-light);margin-bottom:14px;">请选择实验样本种属，工具将自动引导后续选型流程。</p>
    <div class="species-grid" id="species-grid"></div>
  </div>
</div>

<!-- PAGE 2: 人源 subtype -->
<div class="page" id="page-subtype">
  <div class="card">
    <div class="card-title">&#x1F9EA; 第二步：选择试剂盒类型</div>
    <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">
      Human Milliplex 分为三大类型，请根据实验目的选择：
    </p>
    <div class="subtype-grid">
      <div class="subtype-btn" onclick="selectSubtype('screening',event)" id="btn-screening">
        <div class="type-badge badge-screening">筛查型</div>
        <div class="type-name">&#x1F50D; 筛查型</div>
        <div class="type-desc">全面筛查 115 个因子<br>货号 HPLX1-115SP 系列<br>适合探索性研究</div>
      </div>
      <div class="subtype-btn" onclick="selectSubtype('validation',event)" id="btn-validation">
        <div class="type-badge badge-validation">验证型</div>
        <div class="type-name">&#x2705; 验证型</div>
        <div class="type-desc">多款针对性试剂盒<br>精准检测目标因子<br>适合验证性研究</div>
      </div>
      <div class="subtype-btn autoab-btn" onclick="selectSubtype('autoantibody',event)" id="btn-autoantibody">
        <div class="type-badge badge-autoab">自身抗体</div>
        <div class="type-name">&#x1F9EC; 自身抗体免疫试剂盒</div>
        <div class="type-desc">检测自身抗体 IgG/IgA/IgM<br>涵盖自身免疫、肿瘤、神经等<br>QUALITATIVE KIT</div>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-secondary btn-sm" onclick="goBack()">&#8592; 返回种属</button>
    </div>
  </div>
</div>

<!-- PAGE 3: 因子选择 -->
<div class="page" id="page-factors">
  <div class="card">
    <div class="card-title">&#x1F3AF; 第三步：选择检测因子</div>
    <div class="ctx-box" id="factor-context-info"></div>
    <div class="input-mode-tabs">
      <button class="tab-btn active" id="tab-check" onclick="switchTab('check')">&#x2611; 勾选模式</button>
      <button class="tab-btn" id="tab-paste" onclick="switchTab('paste')">&#x1F4CB; 粘贴输入模式</button>
    </div>
    <div class="text-input-area" id="paste-area">
      <textarea id="factor-paste-input" placeholder="支持换行、逗号、中文顿号分隔，因子名称模糊匹配&#10;别名自动识别：IL-12p70 = IL-12 (p70) 等&#10;示例：IL-6, TNFα&#10;IFN-γ、MCP-1、IL12p70"></textarea>
      <div class="hint">&#x2714; 别名智能归并：IL-12p70 / IL12p70 / IL-12(p70) 等均自动匹配为 IL-12 (p70)</div>
      <div style="display:flex;gap:8px;margin-top:8px;">
        <button class="btn btn-primary btn-sm" onclick="parsePasteInput()">&#x1F50D; 分析因子</button>
        <button class="btn btn-secondary btn-sm" onclick="clearPaste()">&#x1F5D1; 清空</button>
      </div>
      <div id="paste-result-info" style="font-size:12px;color:var(--accent);margin-top:6px;"></div>
    </div>
    <div class="text-input-area active" id="check-area">
      <div class="search-wrap">
        <span class="si">&#x1F50E;</span>
        <input type="text" id="factor-search" placeholder="搜索因子名称或别名…" oninput="filterFactors()">
      </div>
      <div class="factor-categories" id="factor-cats"></div>
      <div class="factors-container" id="factors-container"></div>
    </div>
    <div class="selected-bar" id="selected-bar" style="display:none;">
      <div>
        <div class="sel-info" id="sel-count-info"></div>
        <div class="selected-tags" id="selected-tags"></div>
      </div>
      <button class="btn btn-danger btn-sm" onclick="clearAll()">&#x1F5D1; 清空</button>
    </div>
    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goBack()">&#8592; 上一步</button>
      <button class="btn btn-primary" id="match-btn" onclick="doMatch()" disabled>&#x1F52C; 开始匹配 &#x2192;</button>
    </div>
  </div>
</div>

<!-- PAGE 4: 结果 -->
<div class="page" id="page-results">
  <div class="card">
    <div class="card-title">&#x1F4CB; 第四步：匹配结果</div>
    <div class="ctx-box" id="result-summary"></div>
    <div id="results-area"></div>
    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goBack()">&#8592; 修改因子</button>
      <button class="btn btn-primary" onclick="restartAll()">&#x1F504; 重新开始</button>
    </div>
  </div>
</div>

<!-- PAGE: coming soon -->
<div class="page" id="page-coming">
  <div class="card">
    <div class="coming-soon">
      <div style="font-size:42px">&#x1F9EC;</div>
      <p style="margin-top:12px;font-size:15px;font-weight:700;" id="coming-species-name">数据库建设中</p>
      <p style="margin-top:8px;font-size:13px;">数据已录入，请联系管理员更新。</p>
    </div>
    <div class="btn-row" style="justify-content:center;">
      <button class="btn btn-secondary" onclick="goBack()">&#8592; 返回种属</button>
    </div>
  </div>
</div>

</div><!-- /container -->

