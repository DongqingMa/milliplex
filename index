// Build reverse lookup: alias (lowercased, stripped) -> canonical
const ALIAS_REVERSE = {};

// stripKey: normalise string for matching (removes spaces/hyphens/parens/slashes,
// lowercases, and maps Greek letters so \u03B1/a, \u03B2/b, \u03B3/g, \u03BB/l, \u03B4/d, \u03C9/o, \u03B5/e are interchangeable)
function stripKey(s){
  return s.toLowerCase()
    .replace(/[\s\-_()/]/g,'')
    .replace(/\u03B1/g,'a').replace(/\u03B2/g,'b').replace(/\u03B3/g,'g')
    .replace(/\u03B4/g,'d').replace(/\u03BB/g,'l').replace(/\u03C9/g,'o').replace(/\u03B5/g,'e');
}

(function buildAliasReverse(){
  Object.entries(ALIAS_MAP).forEach(([canonical, aliases])=>{
    ALIAS_REVERSE[stripKey(canonical)] = canonical;
    aliases.forEach(a => { ALIAS_REVERSE[stripKey(a)] = canonical; });
  });
  // Also build from all kit factors (post-normalization)
})();

// Normalize a factor name from the database to its canonical form
function canonicalize(name){
  const key = stripKey(name);
  return ALIAS_REVERSE[key] || name;
}

// Normalize all kits' factor arrays at load time
(function normalizeAllKits(){
  ALL_KITS.forEach(kit => {
    if(kit.factors){
      kit.factors = kit.factors.map(f => canonicalize(f));
      // Deduplicate
      kit.factors = [...new Set(kit.factors)];
    }
  });
})();

