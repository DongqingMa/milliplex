function parsePasteInput(){
  const raw = document.getElementById('factor-paste-input').value;
  if(!raw.trim()) return;
  const parts = raw.split(/[\n\r,\uFF0C\u3001\uFF1B;]+/).map(s => s.trim()).filter(Boolean);
  const matched = [], notFound = [];

  parts.forEach(p => {
    if(!p) return;
    const pKey = stripKey(p);

    // Step 1: Alias reverse lookup (handles all registered aliases)
    const canonical = ALIAS_REVERSE[pKey];
    if(canonical){
      const found = state.currentFactors.find(f =>
        f.name === canonical || stripKey(f.name) === stripKey(canonical)
      );
      if(found){ state.selectedFactors.add(found.name); matched.push(found.name); return; }
    }

    // Step 2: Direct strip-match against factor names in currentFactors
    const foundExact = state.currentFactors.find(f => stripKey(f.name) === pKey);
    if(foundExact){ state.selectedFactors.add(foundExact.name); matched.push(foundExact.name); return; }

    // Step 3: Check all ALIAS_MAP entries for any alias matching input
    let aliasMatch = null;
    for(const [can, aliases] of Object.entries(ALIAS_MAP)){
      if(stripKey(can) === pKey || aliases.some(a => stripKey(a) === pKey)){
        const cf = state.currentFactors.find(f =>
          stripKey(f.name) === stripKey(can) ||
          aliases.some(a => stripKey(f.name) === stripKey(a))
        );
        if(cf){ aliasMatch = cf; break; }
      }
    }
    if(aliasMatch){ state.selectedFactors.add(aliasMatch.name); matched.push(aliasMatch.name); return; }

    // Step 4: Substring match (input contained in factor name or vice versa)
    const foundSub = state.currentFactors.find(f => {
      const fn = stripKey(f.name);
      return (pKey.length >= 3 && fn.includes(pKey)) || (fn.length >= 3 && pKey.includes(fn));
    });
    if(foundSub){ state.selectedFactors.add(foundSub.name); matched.push(foundSub.name); return; }

    // Step 5: Fuzzy alias substring match
    let fuzzyMatch = null;
    for(const [can, aliases] of Object.entries(ALIAS_MAP)){
      const allKeys = [stripKey(can), ...aliases.map(a => stripKey(a))];
      if(allKeys.some(k => (pKey.length>=3 && k.includes(pKey)) || (k.length>=3 && pKey.includes(k)))){
        const cf = state.currentFactors.find(f => stripKey(f.name) === stripKey(can));
        if(cf){ fuzzyMatch = cf; break; }
      }
    }
    if(fuzzyMatch){ state.selectedFactors.add(fuzzyMatch.name); matched.push(fuzzyMatch.name); return; }

    notFound.push(p);
  });

  applyFilters(); updateSelectedBar();
  let msg = `\u5339\u914D\u5230 ${matched.length} / ${parts.length} \u4E2A\u56E0\u5B50`;
  if(notFound.length) msg += `\uFF1B\u4E0D\u5728\u5F53\u524D\u8BD5\u5242\u76D2\u5217\u8868\u4E2D\uFF1A${notFound.join('\u3001')}`;
  document.getElementById('paste-result-info').textContent = msg;
}

function clearPaste(){
  document.getElementById('factor-paste-input').value = '';
  document.getElementById('paste-result-info').textContent = '';
}

// ================================================================
// FACTOR LIST
// ================================================================
function renderFactorList(factors){
  state.selectedFactors = new Set();
  updateSelectedBar();
  const cats = [...new Set(factors.map(f => f.group))].sort();
  document.getElementById('factor-cats').innerHTML =
    `<button class="cat-btn active" onclick="filterByGroup(this,'all')">\u5168\u90E8</button>` +
    cats.map(c => `<button class="cat-btn" onclick="filterByGroup(this,'${c.replace(/'/g,"\\'")}')"> ${c}</button>`).join('');
  renderVisibleFactors(factors);
  document.getElementById('factor-search').value = '';
  document.getElementById('match-btn').disabled = true;
}

function filterByGroup(btn, group){
  currentGroupFilter = group;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}

function filterFactors(){ applyFilters(); }

function applyFilters(){
  const search = document.getElementById('factor-search').value.toLowerCase().trim();
  let filtered = state.currentFactors;
  if(currentGroupFilter !== 'all') filtered = filtered.filter(f => f.group === currentGroupFilter);
  if(search){
    const sSearch = stripKey(search);
    filtered = filtered.filter(f => {
      if(f.name.toLowerCase().includes(search)) return true;
      const aliases = ALIAS_MAP[f.name] || [];
      if(aliases.some(a => a.toLowerCase().includes(search))) return true;
      return stripKey(f.name).includes(sSearch);
    });
  }
  renderVisibleFactors(filtered);
}

function renderVisibleFactors(factors){
  const groups = {};
  factors.forEach(f => {
    if(!groups[f.group]) groups[f.group] = [];
    groups[f.group].push(f);
  });
  const container = document.getElementById('factors-container');
  if(!factors.length){
    container.innerHTML = '<div style="padding:18px;text-align:center;color:#999;font-size:13px;">\u672A\u627E\u5230\u5339\u914D\u56E0\u5B50</div>';
    return;
  }
  let html = '';
  Object.entries(groups).sort(([a],[b]) => a.localeCompare(b,'zh')).forEach(([group, fList]) => {
    html += `<div><div class="factor-group-header">${group} (${fList.length})</div>`;
    fList.forEach(f => {
      const sid = 'fc-' + f.name.replace(/[^a-zA-Z0-9]/g,'_');
      const chk = state.selectedFactors.has(f.name) ? 'checked' : '';
      const kb = f.kits && f.kits.length > 1
        ? `<span class="kb">${f.kits.length} \u6B3E</span>`
        : (f.kits && f.kits.length === 1 ? `<span class="kb">${f.kits[0]}</span>` : '');
      // Show known aliases as tooltip
      const aliases = ALIAS_MAP[f.name];
      const aliasHint = aliases && aliases.length
        ? ` title="\u522B\u540D\uFF1A${aliases.slice(0,4).join(' / ')}"` : '';
      const enc = f.name.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
      html += `<div class="factor-item" onclick="toggleFactor('${enc}')">
        <input type="checkbox" id="${sid}" ${chk} onclick="event.stopPropagation();toggleFactor('${enc}')">
        <label for="${sid}"${aliasHint}>${f.name}${aliases&&aliases.length?'<span style="font-size:9px;color:#9BB8D3;margin-left:4px">\u2261</span>':''}</label>${kb}
      </div>`;
    });
    html += '</div>';
  });
  container.innerHTML = html;
}

function toggleFactor(name){
  if(state.selectedFactors.has(name)) state.selectedFactors.delete(name);
  else state.selectedFactors.add(name);
  const cb = document.getElementById('fc-' + name.replace(/[^a-zA-Z0-9]/g,'_'));
  if(cb) cb.checked = state.selectedFactors.has(name);
  updateSelectedBar();
}

function updateSelectedBar(){
  const bar = document.getElementById('selected-bar');
  const count = state.selectedFactors.size;
  document.getElementById('match-btn').disabled = count === 0;
  if(!count){ bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  document.getElementById('sel-count-info').textContent = `\u5DF2\u9009 ${count} \u4E2A\u56E0\u5B50`;
  const arr = Array.from(state.selectedFactors);
  const enc = n => n.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
  document.getElementById('selected-tags').innerHTML =
    arr.slice(0,18).map(n => `<span class="sel-tag">${n} <span class="rm" onclick="event.stopPropagation();toggleFactor('${enc(n)}')">&times;</span></span>`).join('') +
    (arr.length > 18 ? `<span class="sel-tag" style="background:#9BB8D3">+${arr.length-18}\u2026</span>` : '');
}

function clearAll(){
  state.selectedFactors = new Set();
  applyFilters();
  updateSelectedBar();
}

// ================================================================
// MATCH ENGINE
// ================================================================
function doMatch(){
  const selected = Array.from(state.selectedFactors);
  if(!selected.length) return;
  updateBreadcrumb(4);
  if(state.currentMode === 'screening') showScreeningResult(selected);
  else showValidationResult(selected, state.currentKits);
  showPage('page-results');
}

// Greedy set-cover
function greedyCover(selected, kits){
  let remaining = new Set(selected);
  const combo = [];
  const kc = kits.map(k => ({...k, ms: new Set((k.factors||[]).filter(n => selected.includes(n)))}));
  while(remaining.size > 0){
    kc.sort((a,b) => {
      const na = [...a.ms].filter(m => remaining.has(m)).length;
      const nb = [...b.ms].filter(m => remaining.has(m)).length;
      return nb - na;
    });
    const best = kc[0];
    const gain = [...best.ms].filter(m => remaining.has(m));
    if(!gain.length) break;
    combo.push(best.catNo);
    gain.forEach(m => remaining.delete(m));
  }
  return {combo, uncovered:[...remaining]};
}

function showScreeningResult(selected){
  const kit = SCREENING_KIT;
  const matched = selected.filter(s => (kit.factors||[]).includes(s));
  const missing = selected.filter(s => !(kit.factors||[]).includes(s));
  const pct = Math.round(matched.length / selected.length * 100);
  document.getElementById('result-summary').innerHTML =
    `\u60A8\u8F93\u5165\u4E86 <strong>${selected.length}</strong> \u4E2A\u56E0\u5B50\uFF0C\u7B5B\u67E5\u578B\u8BD5\u5242\u76D2 <strong>${kit.catNo}</strong> \u8986\u76D6\u5176\u4E2D <strong>${matched.length}</strong> \u4E2A\uFF08${pct}%\uFF09\u3002`;
  document.getElementById('results-area').innerHTML = `
    <div class="combo-box ${missing.length?'warn':''}">
      <div style="font-size:16px;font-weight:700;color:${missing.length?'#6D4C00':'var(--success)'}">
        \u1F4E6 ${kit.catNo} ${missing.length===0?'<span style="font-size:13px"> \u2705 \u5B8C\u5168\u8986\u76D6\uFF01</span>':''}
      </div>
      <div style="font-size:12px;color:var(--text-light);margin:4px 0 10px">${kit.name}</div>
      <div class="match-stat">
        <span class="match-label">\u56E0\u5B50\u8986\u76D6\u7387</span>
        <div class="match-bar-wrap"><div class="match-bar" style="width:${pct}%"></div></div>
        <span class="match-pct">${pct}%</span>
      </div>
      <div style="font-size:13px;color:var(--text-light);margin-bottom:10px">
        \u5305\u542B\u60A8\u8F93\u5165\u7684 <strong style="color:var(--accent)">${matched.length}/${selected.length}</strong> \u4E2A\u56E0\u5B50
        &middot; \u8BD5\u5242\u76D2\u5171 ${(kit.factors||[]).length} \u4E2A\u56E0\u5B50
      </div>
      ${missing.length>0?`<div class="info-box">\u26A0\uFE0F \u4EE5\u4E0B <strong>${missing.length}</strong> \u4E2A\u56E0\u5B50\u672A\u5728\u6B64\u8BD5\u5242\u76D2\u4E2D\u627E\u5230\uFF1A<strong>${missing.join('\u3001')}</strong></div>`:''}
      <button class="toggle-btn" onclick="toggleKitFactors(this,'_screen_')">\u25B6 \u5C55\u5F00\u5168\u90E8 ${(kit.factors||[]).length} \u4E2A\u56E0\u5B50</button>
      <div class="factors-grid" id="kit-factors-_screen_" style="display:none;margin-top:10px">
        ${(kit.factors||[]).map(f=>`<span class="factor-tag ${selected.includes(f)?'matched':''}">${f}</span>`).join('')}
      </div>
    </div>`;
}

function showValidationResult(selected, kits){
  const isAutoab = state.currentMode === 'autoantibody';
  const scored = kits.map(kit => {
    const names = (kit.factors||[]);
    const matched = selected.filter(s => names.includes(s));
    return {kit, matched, score:matched.length};
  }).filter(r => r.score > 0).sort((a,b) => b.score - a.score || b.kit.factors.length - a.kit.factors.length);

  const summary = document.getElementById('result-summary');
  const area = document.getElementById('results-area');

  if(!scored.length){
    const modeLabel = isAutoab ? '\u81EA\u8EAB\u6297\u4F53\u514D\u75AB\u8BD5\u5242\u76D2' : '\u9A8C\u8BC1\u578B\u8BD5\u5242\u76D2';
    summary.textContent = `\u5728${modeLabel}\u4E2D\u6682\u672A\u627E\u5230\u5339\u914D\u8BD5\u5242\u76D2\uFF0C\u8BF7\u8054\u7CFB\u6280\u672F\u652F\u6301\u3002`;
    area.innerHTML = `<div class="no-result"><div style="font-size:44px">\u1F50D</div><p style="margin-top:10px">\u672A\u627E\u5230\u80FD\u8986\u76D6\u6240\u9009\u56E0\u5B50\u7684\u8BD5\u5242\u76D2</p></div>`;
    return;
  }

  const modeLabel = isAutoab ? '\u81EA\u8EAB\u6297\u4F53\u514D\u75AB' : '\u9A8C\u8BC1\u578B';
  summary.innerHTML = `\u60A8\u8F93\u5165\u4E86 <strong>${selected.length}</strong> \u4E2A\u76EE\u6807\u56E0\u5B50\uFF0C\u5728<strong>${modeLabel}\u8BD5\u5242\u76D2</strong>\u4E2D\u5171\u627E\u5230 <strong>${scored.length}</strong> \u6B3E\u5339\u914D\uFF08\u6309\u8986\u76D6\u6570\u91CF\u6392\u5E8F\uFF09\uFF1A`;

  const {combo, uncovered} = greedyCover(selected, kits);
  const allCovered = selected.filter(s => !uncovered.includes(s));
  let comboHtml = '';
  if(combo.length === 1 && uncovered.length === 0){
    comboHtml = `<div class="combo-box" style="margin-bottom:14px">\u2705 <strong>${combo[0]}</strong> \u53EF\u5B8C\u5168\u8986\u76D6\u60A8\u8F93\u5165\u7684\u6240\u6709 <strong>${selected.length}</strong> \u4E2A\u56E0\u5B50\uFF01</div>`;
  } else if(combo.length > 1){
    comboHtml = `<div class="combo-box warn" style="margin-bottom:14px">\u1F4A1 <strong>\u6700\u5C11\u8BD5\u5242\u76D2\u7EC4\u5408\u5EFA\u8BAE\uFF1A</strong>\u8054\u5408\u4F7F\u7528 <strong>${combo.join(' + ')}</strong>\uFF0C\u53EF\u8986\u76D6 <strong>${allCovered.length}/${selected.length}</strong> \u4E2A\u56E0\u5B50${uncovered.length>0?`\uFF1B\u4EE5\u4E0B\u56E0\u5B50\u6682\u65E0\u8BD5\u5242\u76D2\u8986\u76D6\uFF1A<strong>${uncovered.join('\u3001')}</strong>`:'\uFF08\u5168\u90E8\u8986\u76D6 \u2713)'}\u3002</div>`;
  } else if(uncovered.length > 0){
    comboHtml = `<div class="info-box" style="margin-bottom:14px">\u26A0\uFE0F \u4EE5\u4E0B\u56E0\u5B50\u5728\u6240\u6709\u8BD5\u5242\u76D2\u4E2D\u5747\u672A\u627E\u5230\uFF1A<strong>${uncovered.join('\u3001')}</strong></div>`;
  }

  area.innerHTML = comboHtml + scored.map((r,i) => {
    const pct = Math.round(r.score / selected.length * 100);
    const isAutoabKit = AUTOAB_CATNOS.has(r.kit.catNo);
    return `<div class="result-kit ${i===0?'best-match':''} ${isAutoabKit?'autoab-kit':''}">
      <div class="kit-header">
        <div>
          <div class="kit-cat-no">\u1F4E6 ${r.kit.catNo}</div>
          <div style="font-size:12px;opacity:.85;margin-top:2px">${r.kit.name}</div>
        </div>
        <div class="kit-badges">
          ${i===0?'<span class="badge badge-best">\u2B50 \u6700\u4F73\u5339\u914D</span>':''}
          <span class="badge badge-count">\u8986\u76D6 ${r.score}/${selected.length} \u4E2A</span>
          ${r.kit.note&&r.kit.note!=='\u65E0'?`<span class="badge" style="background:rgba(255,255,255,0.18);color:#fff;font-size:10px">${r.kit.note}</span>`:''}
        </div>
      </div>
      <div class="kit-body">
        <div class="match-stat">
          <span class="match-label">\u56E0\u5B50\u8986\u76D6\u7387</span>
          <div class="match-bar-wrap"><div class="match-bar" style="width:${pct}%"></div></div>
          <span class="match-pct">${pct}%</span>
        </div>
        <div style="font-size:12px;color:var(--text-light);margin-bottom:9px">
          \u547D\u4E2D\u56E0\u5B50\uFF1A<strong style="color:var(--accent)">${r.matched.join('\u3001')}</strong>
        </div>
        <button class="toggle-btn" onclick="toggleKitFactors(this,'${r.kit.catNo.replace(/'/g,"\\'")}')">\u25B6 \u5C55\u5F00\u5168\u90E8 ${(r.kit.factors||[]).length} \u4E2A\u56E0\u5B50</button>
        <div class="factors-grid" id="kit-factors-${r.kit.catNo.replace(/[^a-zA-Z0-9]/g,'_')}" style="display:none;margin-top:9px">
          ${(r.kit.factors||[]).map(f=>`<span class="factor-tag ${selected.includes(f)?'matched':''}">${f}</span>`).join('')}
        </div>
      </div>
    </div>`;
  }).join('');
}

function toggleKitFactors(btn, catNo){
  const safeId = catNo.replace(/[^a-zA-Z0-9]/g,'_');
  const el = document.getElementById('kit-factors-'+safeId) || document.getElementById('kit-factors-'+catNo);
  if(!el) return;
  if(el.style.display === 'none'){
    el.style.display = 'flex';
    btn.textContent = '\u25BC \u6536\u8D77\u56E0\u5B50\u5217\u8868';
  } else {
    el.style.display = 'none';
    const kit = ALL_KITS.find(k => k.catNo === catNo) || {factors:[]};
    btn.textContent = `\u25B6 \u5C55\u5F00\u5168\u90E8 ${(kit.factors||[]).length} \u4E2A\u56E0\u5B50`;
  }
}

