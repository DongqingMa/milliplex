  window.scrollTo(0,0);
}

function updateBreadcrumb(step){
  for(let i=1;i<=4;i++){
    const el = document.getElementById('bc'+i);
    el.className = 'step'+(i<step?' done':i===step?' active':'');
    el.querySelector('.num').textContent = i<step ? '\u2713' : i;
  }
  const sep2 = document.getElementById('bc-sep2');
  if(state.species !== 'human'){
    document.getElementById('bc2').style.display = 'none';
    if(sep2) sep2.style.display = 'none';
  } else {
    document.getElementById('bc2').style.display = '';
    if(sep2) sep2.style.display = '';
  }
}

function goBack(){
  const cur = document.querySelector('.page.active').id;
  if(cur === 'page-subtype' || cur === 'page-coming'){
    state.species = null;
    showPage('page-species'); updateBreadcrumb(1);
  } else if(cur === 'page-factors'){
    state.selectedFactors = new Set();
    if(state.species === 'human'){
      showPage('page-subtype'); updateBreadcrumb(2);
    } else {
      state.species = null;
      showPage('page-species'); updateBreadcrumb(1);
    }
  } else if(cur === 'page-results'){
    showPage('page-factors'); updateBreadcrumb(3);
  }
}

